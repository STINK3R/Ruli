# Для запуска Django напрямую на компьютере нужен доступный MySQL.
# В Compose параметры подключения задаются сервисом db и этот файл не используется.
DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=mysql://carsharing:carsharing@127.0.0.1:3306/carsharing
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173
FREE_WAITING_MINUTES=10
